# Copy this file to .env to connect approved UAE PASS credentials.
# Password-based shelter accounts work without UAE PASS.
SHELTER_AUTH_MODE=simulation
# Set SHELTER_AUTH_MODE=real to disable simulated sign-in and use the real data store.
UAEPASS_ENV=staging
UAEPASS_CLIENT_ID=
UAEPASS_CLIENT_SECRET=
UAEPASS_REDIRECT_URI=
# Example registered callback: https://your-approved-host/api/auth/callback
# Link the verified UAE PASS UUID when creating the user's account.
# Video recordings work without machine-learning dependencies.
SHELTER_ENABLE_AI=1
